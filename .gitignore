# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# 설정 방법 안내용 예시 파일은 올린다 (비밀값이 들어 있지 않다)
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# 사주 해석 캐시 (구독 사용량을 아끼려고 저장해 둔 결과)
/.cache
