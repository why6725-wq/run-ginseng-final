# 이 파일을 .env.local 로 복사한 뒤 값을 채워 주세요.
#   cp .env.example .env.local
#
# .env.local 은 git 에 올라가지 않습니다. 토큰은 비밀번호와 같으니 절대 공유하지 마세요.


# ─────────────────────────────────────────────────────────────
# 1. 구독 요금제로 쓰기 (지금 쓰는 방식, 권장)
# ─────────────────────────────────────────────────────────────
#
# 터미널에서 아래 명령을 실행하면 브라우저 로그인 창이 뜹니다.
# 승인하면 1년짜리 토큰이 화면에 찍힙니다. 그 값을 여기에 붙여넣으세요.
#
#   claude setup-token
#
# 이 토큰은 회원님의 Claude 구독(Pro, Max, Team, Enterprise)에 연결됩니다.
# 따로 요금이 청구되지 않고 구독 사용량에서 차감됩니다.
#
# CLAUDE_CODE_OAUTH_TOKEN=여기에_붙여넣기


# ─────────────────────────────────────────────────────────────
# 2. API 키로 쓰기 (나중에 남에게 서비스할 때)
# ─────────────────────────────────────────────────────────────
#
# 쓴 만큼 요금이 나가는 방식입니다. https://platform.claude.com 에서 발급합니다.
# 이 값이 있으면 위의 구독 토큰보다 우선합니다.
#
# 주의: Anthropic 공식 문서는 "사전 승인 없이는 서드파티 개발자가 자사 제품에
# claude.ai 로그인이나 요금제 한도를 제공할 수 없다"고 밝히고 있습니다.
# 이 사이트를 남들이 쓰게 하려면 반드시 아래 API 키 방식으로 바꿔야 합니다.
#
# ANTHROPIC_API_KEY=sk-ant-...


# ─────────────────────────────────────────────────────────────
# 3. 사용할 모델 (선택)
# ─────────────────────────────────────────────────────────────
#
# 비워두면 claude-sonnet-5 를 씁니다. 더 깊은 해석을 원하면 claude-opus-5 로 바꾸세요.
# 대신 느려지고 사용량을 더 씁니다.
#
# SAJU_MODEL=claude-sonnet-5
